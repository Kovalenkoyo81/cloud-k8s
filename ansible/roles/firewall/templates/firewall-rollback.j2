#!/bin/sh
# {{ ansible_managed }}
# Run by a timer if access was not confirmed after applying.
# Removes the jump to {{ firewall_chain }} and disables loading the rules at boot.

iptables -w -D INPUT -j {{ firewall_chain }} || true
{% if firewall_ipv6 %}
ip6tables -w -D INPUT -j {{ firewall_chain }} || true
{% endif %}
systemctl disable firewall.service || true

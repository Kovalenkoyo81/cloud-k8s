---
# Compatible with ansible-lint: same limits it enforces itself
extends: default

ignore: |
  ansible/inventory/group_vars/all/vault.yml

rules:
  line-length:
    max: 160
  braces:
    max-spaces-inside: 1
  # "uses: action@sha # vX.Y.Z" — one space before the comment
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    # "on:" in GitHub Actions is a key, not a boolean
    check-keys: false
